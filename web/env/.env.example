# Copia este fichero a env/.env.local (ignorado por git) y rellénalo.
# IP del PC donde corre el backend, alcanzable desde el RC Plus / Dock (la misma SERVER_IP del backend)
VITE_SERVER_IP=192.168.1.100

# Credenciales de la app Cloud API (developer.dji.com). Las mismas que en iadron/.env del backend.
VITE_DJI_APP_ID=
VITE_DJI_APP_KEY=
VITE_DJI_APP_LICENSE=

# Opcionales (si no se ponen se construyen con VITE_SERVER_IP)
# VITE_BACKEND_URL=http://192.168.1.100:6789/
# VITE_WEBSOCKET_URL=ws://192.168.1.100:6789/api/v1/ws
# VITE_AMAP_KEY=
