# IP del PC servidor en la red donde están el Dock 2 / RC Plus (NO localhost: el Dock la tiene que alcanzar)
SERVER_IP=192.168.1.100

MYSQL_ROOT_PASSWORD=root
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Usuario de aplicación de MinIO que usa el backend (AssumeRole no se usa con la cuenta root)
MINIO_APP_USER=iadron
MINIO_APP_PASSWORD=iadron-minio-123

# Credenciales de la app Cloud API (developer.dji.com > Apps > tipo Cloud API)
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=

# Servidor central de IADron (vacío = no reenviar, sólo log local). Ej: http://192.168.1.50:8090
IADRON_CENTRAL_URL=http://localhost:8090
